# Supabase (Postgres database + Storage bucket for CMS & AI Concierge)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Gemini API configuration for AI Chatbot & CMS Auto-Translation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DECISION_MODEL=

# Tavily Web Search for real-time local ticket, pricing & Q&A verification
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=10000
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_ANSWER=true
TAVILY_MAX_RESULTS=5
TAVILY_COUNTRY=vietnam

# AI Concierge Pipeline & Price Policy Settings
AI_PRICE_TTL_HOURS=168
AI_CHAT_TIMEOUT_MS=30000
AI_RESPONSE_MAX_TOKENS=4096

# Arize AX OpenTelemetry Observability (US default: https://otlp.arize.com)
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=dak-lak-travel-concierge
ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com

# Optional Server & Rate Limit overrides
# CMS_PORT=4000
# AI_CHAT_RATE_LIMIT_MAX=30
