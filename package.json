{
  "name": "dak-lak-travel-spa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "daklak-cms": "cli/index.ts"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "cms": "tsx cli/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "eval:ai": "tsx --test tests/ai-evals.test.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@arizeai/openinference-core": "^2.8.3",
    "@arizeai/openinference-semantic-conventions": "^2.17.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@langchain/core": "^1.4.2",
    "@langchain/google-genai": "^2.3.6",
    "@langchain/langgraph": "^1.7.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.212.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@supabase/supabase-js": "2.119.2",
    "@tavily/core": "^1.1.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "maplibre-gl": "^6.18.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
